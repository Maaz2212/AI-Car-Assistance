# ─────────────────────────────────────────────────────────────
# AI Car Matchmaker — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js (frontend) ───────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/

# ── TypeScript compiled output ────────────────────────────────
dist/
build/
backend/dist/
mcp-servers/dist/
*.js.map
*.d.ts.map

# ── Environment variables — NEVER commit secrets ─────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# ── OS generated files ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# ── Coverage & Testing ────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.cache/
jest-results/

# ── Docker ───────────────────────────────────────────────────
# (keep docker-compose.yml and Dockerfile — they should be committed)
.docker/

# ── Package managers ─────────────────────────────────────────
# Keep package-lock.json (important for reproducible installs)
# Ignore yarn/pnpm lockfiles if using npm
yarn.lock
pnpm-lock.yaml

# ── Misc ─────────────────────────────────────────────────────
*.tsbuildinfo
.eslintcache
.stylelintcache
*.tmp
*.bak
*.orig
.vercel
.netlify
